{
  "manifest_version": 3,
  "name": "Sensibility Matcher",
  "version": "2.5",
  "action": { "default_popup": "popup.html" },
  "permissions": ["activeTab", "storage", "contextMenus", "scripting"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}